---
import {
	Handbag,
	Headphones,
	Layers,
	LayoutGrid,
	ShieldCheck,
	ShoppingCart,
	Truck,
} from 'lucide-astro';
import TypewriterText from '@astroanimate/core/TypewriterText';
import { supabase } from '~/lib/supabase';
import { RiFinanceMoneyDollarBoxFill } from 'solid-icons/ri';

/* Defines the promotional banner data required by the homepage hero. */
interface FeaturedBanner {
	id: string;
	title: string;
	image_url: string;
	alt_text: string | null;
	link_url: string | null;
	display_order: number;
}

/* Loads active homepage promotional banners in their configured order. */
const { data: featuredBanners, error: featuredBannersError } = await supabase
	.from('featured_banners')
	.select(
		`
    id,
    title,
    image_url,
    alt_text,
    link_url,
    display_order
  `,
	)
	.eq('is_active', true)
	.or(`starts_at.is.null,starts_at.lte.${new Date().toISOString()}`)
	.or(`ends_at.is.null,ends_at.gte.${new Date().toISOString()}`)
	.order('display_order', {
		ascending: true,
	});

/* Logs banner loading failures without preventing the homepage from rendering. */
if (featuredBannersError) {
	console.error('Failed to load TweakMart featured banners:', featuredBannersError);
}

const banners = (featuredBanners ?? []) as FeaturedBanner[];
---

<section class="breakout bg-white md:bg-[#000033]">
	<div
		class="content grid min-h-[520px] items-center gap-10 md:py-10 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:py-16"
	>
		<div class="max-w-2xl">
			<h1
				class="max-w-2xl text-5xl font-extrabold leading-[1.08] tracking-tight text-blue-700 sm:text-5xl md:text-white lg:text-6xl"
			>
				Everything you need to power your
				<span class="text-pink-500">
					<TypewriterText
						texts={['technology', 'business', 'company']}
						typeSpeed={90}
						eraseSpeed={90}
						pauseAfter={2800}
						enhance
					/>
				</span>
			</h1>

			<p class="mt-6 max-w-xl text-base leading-7 sm:text-lg sm:leading-8 md:text-white">
				Shop trusted laptops, networking equipment, software licenses, accessories, and enterprise
				technology solutions from TweakMart.
			</p>

			<div class="mt-8 flex flex-row gap-3">
				<a
					href="/products"
					class="group inline-flex h-12 w-full items-center justify-center gap-2 rounded-full bg-gradient-to-r from-pink-500 via-fuchsia-500 to-blue-600 px-6 text-xs font-bold text-white shadow-md transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg hover:brightness-110 sm:min-w-40 md:rounded-md"
				>
					Shop products

					<Handbag size={18} class="transition-transform duration-300 group-hover:translate-x-1" />
				</a>

				<a
					href="/collections"
					class="group inline-flex h-12 w-full items-center justify-center gap-2 rounded-full border bg-transparent px-6 text-xs font-bold md:rounded-md md:text-white"
				>
					Browse categories

					<Layers size={18} class="transition-transform duration-300 group-hover:translate-x-1" />
				</a>
			</div>

			<div
				class="mt-9 hidden max-w-full grid-cols-2 gap-4 rounded-xl border px-2 pb-6 pt-6 md:grid md:grid-cols-3 md:border-slate-500"
			>
				<div class="flex items-center gap-3">
					<div
						class="flex size-9 shrink-0 items-center justify-center rounded-full bg-blue-500 shadow-sm md:bg-white"
					>
						<ShieldCheck size={18} class="text-white md:text-pink-500" />
					</div>

					<div>
						<p class="text-sm font-bold md:text-white">Trusted products</p>
						<p class="mt-0.5 text-xs md:text-white">Quality assured</p>
					</div>
				</div>

				<div class="flex items-center gap-3">
					<div
						class="flex size-9 shrink-0 items-center justify-center rounded-full bg-blue-500 shadow-sm md:bg-white"
					>
						<Truck size={18} class="text-white md:text-pink-500" />
					</div>

					<div>
						<p class="text-sm font-bold md:text-white">Reliable delivery</p>
						<p class="mt-0.5 text-xs md:text-white">Across Nigeria</p>
					</div>
				</div>

				<div class="flex items-center gap-3">
					<div
						class="flex size-9 shrink-0 items-center justify-center rounded-full bg-blue-500 shadow-sm md:bg-white"
					>
						<Headphones size={18} class="text-white md:text-pink-500" />
					</div>

					<div>
						<p class="text-sm font-bold md:text-white">Expert support</p>
						<p class="mt-0.5 text-[11px] md:text-white">When you need it</p>
					</div>
				</div>

				<div class="flex items-center gap-3 md:hidden">
					<div
						class="flex size-9 shrink-0 items-center justify-center rounded-full bg-blue-500 shadow-sm md:bg-white"
					>
						<ShieldCheck size={18} class="text-white md:text-pink-500" />
					</div>

					<div>
						<p class="text-sm font-bold md:text-white">Safe Payments</p>
						<p class="mt-0.5 text-[11px] md:text-white">Secured by Paystack</p>
					</div>
				</div>
			</div>
		</div>

		<div class="relative h-full min-h-[460px]">
			<div
				class="absolute inset-0 overflow-hidden rounded-[0.5rem] bg-slate-100"
				data-featured-banner-container
			>
				{
					banners.length > 0 ? (
						banners.map((banner, index) => {
							const bannerClasses = [
								'absolute inset-0 transition-opacity duration-1000 ease-in-out',
								index === 0 ? 'pointer-events-auto opacity-100' : 'pointer-events-none opacity-0',
							];

							const bannerImage = (
								<img
									src={banner.image_url}
									alt={banner.alt_text ?? banner.title}
									class="size-full object-cover"
									loading={index === 0 ? 'eager' : 'lazy'}
									fetchpriority={index === 0 ? 'high' : 'auto'}
								/>
							);

							return banner.link_url ? (
								<a
									href={banner.link_url}
									aria-label={banner.title}
									data-featured-banner
									class:list={bannerClasses}
								>
									{bannerImage}
								</a>
							) : (
								<div data-featured-banner class:list={bannerClasses}>
									{bannerImage}
								</div>
							);
						})
					) : (
						<div class="absolute inset-0 flex items-center justify-center bg-slate-100">
							<p class="text-sm text-slate-500">TweakMart</p>
						</div>
					)
				}

				<div
					class="pointer-events-none absolute inset-x-0 bottom-0 z-10 hidden bg-gradient-to-t from-blue-200 via-black/10 to-transparent p-8 pt-24 md:block"
				>
					<div
						class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-xs font-bold text-orange-500 shadow-lg backdrop-blur"
					>
						<div class="rounded-full border bg-orange-50 p-2">
							<ShoppingCart size={20} class="text-orange-500" />
						</div>

						Shop smarter with TweakMart
					</div>
				</div>
			</div>

			<div
				class="pointer-events-none absolute -left-6 -top-12 z-20 hidden rounded-2xl border border-slate-200 bg-white p-2 shadow-xl md:block"
			>
				<div class="flex items-center gap-3">
					<div class="flex size-10 items-center justify-center rounded-full bg-pink-50">
						<RiFinanceMoneyDollarBoxFill size={20} class="text-pink-500" />
					</div>

					<div>
						<p class="text-sm font-bold text-slate-950">Buy at best prices</p>
						<p class="text-xs font-medium text-slate-500">For individuals and firms</p>
					</div>
				</div>
			</div>

			<div
				class="pointer-events-none absolute -bottom-4 -right-4 z-20 rounded-2xl border border-slate-200 bg-green-50 p-2 shadow-xl"
			>
				<div class="flex items-center gap-3">
					<div class="flex size-10 items-center justify-center rounded-full bg-green-200">
						<ShieldCheck size={20} class="text-green-600" />
					</div>

					<div>
						<p class="text-xs text-slate-500">Buy with confidence</p>

						<p class="text-sm font-extrabold text-slate-950">Secure checkout</p>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	/** Initializes the automatic TweakMart promotional banner rotation. */
	function initializeFeaturedBannerRotation() {
		const banners = Array.from(document.querySelectorAll<HTMLElement>('[data-featured-banner]'));

		/* A single banner does not require automatic rotation. */
		if (banners.length <= 1) {
			return;
		}

		let activeIndex = 0;

		/** Displays one banner while fading all other banners out. */
		function showBanner(index: number) {
			banners.forEach((banner, bannerIndex) => {
				const isActive = bannerIndex === index;

				banner.classList.toggle('opacity-100', isActive);
				banner.classList.toggle('opacity-0', !isActive);
				banner.classList.toggle('pointer-events-auto', isActive);
				banner.classList.toggle('pointer-events-none', !isActive);
			});
		}

		/* Rotate promotional images every six seconds. */
		window.setInterval(() => {
			activeIndex = (activeIndex + 1) % banners.length;

			showBanner(activeIndex);
		}, 6000);
	}

	document.addEventListener('astro:page-load', initializeFeaturedBannerRotation);

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializeFeaturedBannerRotation, {
			once: true,
		});
	} else {
		initializeFeaturedBannerRotation();
	}
</script>
