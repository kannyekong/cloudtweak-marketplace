---
import { Building2, Headphones, Newspaper, PackageSearch, ArrowUpRight } from 'lucide-astro';

const quickLinks = [
	{
		title: 'Buy as an organization',
		description: 'Bulk orders, procurement and tailored business purchasing.',
		href: '/bulk-orders',
		icon: Building2,
		iconClass: 'bg-blue-50 text-blue-600',
	},
	{
		title: 'Contact support',
		description: 'Get help with your order, products or TweakMart services.',
		href: '/technical-support',
		icon: Headphones,
		iconClass: 'bg-pink-50 text-pink-600',
	},
	{
		title: 'TweakMart Blog',
		description: 'Buying guides, product insights and practical tech advice.',
		href: '/blog',
		icon: Newspaper,
		iconClass: 'bg-violet-50 text-violet-600',
	},
	{
		title: 'Track your orders',
		description: 'Check the latest status and progress of your TweakMart order.',
		href: '/shipping-delivery',
		icon: PackageSearch,
		iconClass: 'bg-emerald-50 text-emerald-600',
	},
];
---

<section class="bg-white py-8">
	<div class="mx-auto max-w-7xl sm:px-6 lg:px-8">
		<div
			class="grid overflow-hidden rounded-2xl border border-slate-200 bg-white sm:grid-cols-2 md:grid-cols-4"
		>
			{
				quickLinks.map((item, index) => {
					const Icon = item.icon;

					return (
						<a
							href={item.href}
							class:list={[
								'group relative flex min-h-[170px] flex-col p-5 transition hover:bg-slate-50',
								index !== quickLinks.length - 1 && 'border-b border-slate-200 sm:border-b-0',
								index === 0 && 'sm:border-r',
								index === 1 && 'md:border-r',
								index === 2 && 'sm:border-r md:border-r',
							]}
						>
							<div class="flex items-start justify-between gap-4">
								<div
									class:list={[
										'flex size-11 shrink-0 items-center justify-center rounded-xl',
										item.iconClass,
									]}
								>
									<Icon size={21} stroke-width={1.8} />
								</div>

								<ArrowUpRight
									size={18}
									class="text-slate-300 transition duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-blue-600"
								/>
							</div>

							<div class="mt-5">
								<h3 class="text-sm font-bold text-slate-950 transition group-hover:text-blue-600">
									{item.title}
								</h3>

								<p class="mt-2 text-xs leading-5 text-slate-500">{item.description}</p>
							</div>
						</a>
					);
				})
			}
		</div>
	</div>
</section>
