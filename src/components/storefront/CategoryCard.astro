---
import { ArrowRight, ShoppingBag } from 'lucide-astro';

interface Props {
	name: string;
	slug: string;
	description?: string | null;
	imageUrl?: string | null;
	featured?: boolean;
	compact?: boolean;
}

const {
	name,
	slug,
	description = null,
	imageUrl = null,
	featured = false,
	compact = false,
} = Astro.props;

/* Builds the storefront URL for the selected category. */
const categoryHref = `/collections/${encodeURIComponent(slug)}`;
---

<a
	href={categoryHref}
	data-astro-reload
	aria-label={`Shop ${name}`}
	class="group relative flex h-full min-w-0 cursor-pointer flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-200 hover:-translate-y-1 hover:border-blue-200 hover:shadow-xl"
>
	<div
		class:list={[
			'relative overflow-hidden bg-slate-100',
			compact ? 'aspect-square' : 'aspect-[4/3]',
		]}
	>
		{
			imageUrl ? (
				<img
					src={imageUrl}
					alt={name}
					class:list={[
						'h-full w-full object-contain transition duration-300 group-hover:scale-105',
						compact ? 'p-4' : 'p-5',
					]}
					loading="lazy"
				/>
			) : (
				<div class="flex h-full w-full items-center justify-center">
					<div class="flex size-14 items-center justify-center rounded-2xl bg-white shadow-sm">
						<ShoppingBag class="size-6 text-blue-500" />
					</div>
				</div>
			)
		}

		{
			featured && (
				<span class="absolute left-3 top-3 rounded-full bg-pink-500 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wide text-white">
					Featured
				</span>
			)
		}
	</div>

	<div class:list={['flex flex-1 flex-col', compact ? 'p-3.5' : 'p-4']}>
		<h3
			class:list={[
				'line-clamp-1 font-bold text-slate-950 transition group-hover:text-blue-600',
				compact ? 'text-sm' : 'text-sm sm:text-base',
			]}
		>
			{name}
		</h3>

		{
			!compact && (
				<p class="mt-2 line-clamp-2 text-xs leading-5 text-slate-500">
					{description ?? `Browse products available in ${name}.`}
				</p>
			)
		}

		<div
			class:list={['mt-auto flex items-center justify-between gap-3', compact ? 'pt-3' : 'pt-5']}
		>
			<span class="text-xs font-bold text-blue-600"> Shop category</span>

			<div
				class="flex size-8 items-center justify-center rounded-full bg-blue-500 text-white transition group-hover:bg-blue-600 group-hover:text-white"
			>
				<ArrowRight class="size-3.5" />
			</div>
		</div>
	</div>
</a>
