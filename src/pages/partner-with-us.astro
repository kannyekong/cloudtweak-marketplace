---
import {
	ArrowRight,
	BadgeCheck,
	Boxes,
	Building2,
	CheckCircle2,
	Cloud,
	PackageCheck,
	Rocket,
	ShieldCheck,
	Store,
	Users,
} from 'lucide-astro';

import Layout from '../layouts/PrimaryLayout.astro';
---

<Layout
	title="Partner With Us | TweakMart"
	description="Partner with TweakMart, a CloudTweak product, to expand technology access, distribution, services and customer value."
>
	<!-- Partnership types -->
	<section class="border-y border-slate-200">
		<div class="mx-auto max-w-[1440px] px-4 py-16 sm:px-6 md:py-24 xl:px-8">
			<div class="max-w-2xl">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
					Partnership opportunities
				</p>

				<h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
					Different ways we can work together.
				</h2>

				<p class="mt-4 text-base leading-7 text-slate-600">
					Our partnership model is flexible because the technology ecosystem is not
					one-size-fits-all.
				</p>
			</div>

			<div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				<article class="rounded-3xl border border-slate-200 bg-white p-6">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-600"
					>
						<Store class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">Brand Partnerships</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						Work with TweakMart to improve product visibility, customer education and access to your
						technology.
					</p>
				</article>

				<article class="rounded-3xl border border-slate-200 bg-white p-6">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-violet-50 text-violet-600"
					>
						<Boxes class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">Distribution & Supply</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						Support product availability, sourcing and fulfillment for customer and organizational
						technology requirements.
					</p>
				</article>

				<article class="rounded-3xl border border-slate-200 bg-white p-6">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600"
					>
						<ShieldCheck class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">Service Partnerships</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						Collaborate on installation, deployment, migration, configuration or specialized
						technology services.
					</p>
				</article>

				<article class="rounded-3xl border border-slate-200 bg-white p-6">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-amber-50 text-amber-600"
					>
						<Building2 class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">Strategic Partnerships</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						Explore broader commercial, operational or go-to-market opportunities where our
						capabilities complement each other.
					</p>
				</article>
			</div>
		</div>
	</section>

	<!-- Benefits -->
	<section class="bg-white">
		<div
			class="mx-auto grid max-w-[1440px] gap-12 px-4 py-16 sm:px-6 md:grid-cols-2 md:items-center md:py-24 xl:px-8"
		>
			<div class="relative overflow-hidden rounded-[2rem] bg-slate-100 p-3">
				<img
					src="https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1400&q=85"
					alt="Business partnership meeting"
					class="aspect-[4/3] w-full rounded-[1.5rem] object-cover"
					loading="lazy"
				/>

				<div class="absolute bottom-7 left-7 max-w-xs rounded-2xl bg-white p-4 shadow-xl">
					<div class="flex items-center gap-3">
						<div
							class="flex size-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600"
						>
							<Rocket class="size-4" />
						</div>

						<div>
							<p class="text-xs font-bold text-slate-950">Built to grow together</p>

							<p class="mt-1 text-[11px] text-slate-500">
								Long-term value over one-off transactions
							</p>
						</div>
					</div>
				</div>
			</div>

			<div>
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
					What partners gain
				</p>

				<h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
					A platform connected to real customer needs.
				</h2>

				<p class="mt-5 text-base leading-8 text-slate-600">
					TweakMart sits at the intersection of technology purchasing, organizational sourcing and
					technical implementation. That gives partners a more meaningful path to customers.
				</p>

				<div class="mt-7 space-y-4">
					<div class="flex items-start gap-3">
						<CheckCircle2 class="mt-0.5 size-5 shrink-0 text-blue-600" />

						<div>
							<p class="text-sm font-bold text-slate-950">Access to business buying journeys</p>
							<p class="mt-1 text-sm leading-6 text-slate-600">
								Engage with customers who may need more than a single product purchase.
							</p>
						</div>
					</div>

					<div class="flex items-start gap-3">
						<CheckCircle2 class="mt-0.5 size-5 shrink-0 text-blue-600" />

						<div>
							<p class="text-sm font-bold text-slate-950">Broader technology ecosystem</p>
							<p class="mt-1 text-sm leading-6 text-slate-600">
								Connect commerce opportunities with sourcing, support and implementation.
							</p>
						</div>
					</div>

					<div class="flex items-start gap-3">
						<CheckCircle2 class="mt-0.5 size-5 shrink-0 text-blue-600" />

						<div>
							<p class="text-sm font-bold text-slate-950">Flexible collaboration</p>
							<p class="mt-1 text-sm leading-6 text-slate-600">
								Build partnership models around your actual products, services and capabilities.
							</p>
						</div>
					</div>

					<div class="flex items-start gap-3">
						<CheckCircle2 class="mt-0.5 size-5 shrink-0 text-blue-600" />

						<div>
							<p class="text-sm font-bold text-slate-950">CloudTweak connection</p>
							<p class="mt-1 text-sm leading-6 text-slate-600">
								Benefit from a commerce platform backed by CloudTweak&apos;s broader technology
								focus.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CloudTweak -->
	<section class="bg-[#000033] text-white">
		<div class="mx-auto max-w-[1440px] px-4 py-16 sm:px-6 md:py-24 xl:px-8">
			<div
				class="grid overflow-hidden rounded-[2rem] border border-white/10 bg-white/5 md:grid-cols-[1.05fr_0.95fr]"
			>
				<div class="p-6 sm:p-8 md:p-10 lg:p-12">
					<div
						class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-bold text-blue-200"
					>
						<Cloud class="size-4" />
						A CloudTweak Product
					</div>

					<h2 class="mt-5 max-w-xl text-3xl font-black tracking-tight sm:text-4xl">
						Partnerships can go beyond the marketplace.
					</h2>

					<p class="mt-5 max-w-xl text-base leading-8 text-slate-300">
						TweakMart is part of CloudTweak Technologies. That means partnerships can potentially
						extend beyond commerce into cloud, infrastructure, deployment, digital operations and
						other technology initiatives where there is a strong fit.
					</p>

					<p class="mt-4 max-w-xl text-base leading-8 text-slate-300">
						Our goal is to build practical partnerships that help customers get more value from
						technology while creating sustainable opportunities for everyone involved.
					</p>

					<a
						href="https://cloudtweak.net"
						class="mt-7 inline-flex min-h-11 items-center gap-2 rounded-xl bg-white px-4 text-sm font-bold text-[#000033] transition hover:bg-blue-50"
					>
						Explore CloudTweak
						<ArrowRight class="size-4" />
					</a>
				</div>

				<div
					class="relative min-h-[340px] border-t border-white/10 md:min-h-full md:border-l md:border-t-0"
				>
					<img
						src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1400&q=85"
						alt="Modern cloud and technology infrastructure"
						class="absolute inset-0 size-full object-cover"
						loading="lazy"
					/>

					<div
						class="absolute inset-0 bg-gradient-to-t from-[#000033]/90 via-[#000033]/20 to-transparent"
						aria-hidden="true"
					>
					</div>

					<div class="absolute bottom-6 left-6 right-6">
						<div class="rounded-2xl border border-white/10 bg-[#000033]/70 p-5 backdrop-blur-lg">
							<p class="text-xs font-bold uppercase tracking-[0.15em] text-blue-300">
								One broader ecosystem
							</p>

							<p class="mt-2 text-lg font-bold text-white">
								Commerce, technology and services working together.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Who should reach out -->
	<section class="bg-slate-50">
		<div class="mx-auto max-w-[1440px] px-4 py-16 sm:px-6 md:py-24 xl:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
					Who should reach out?
				</p>

				<h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
					If you see a way to create value together, we want to hear from you.
				</h2>
			</div>

			<div class="mt-10 grid gap-4 md:grid-cols-3">
				<article class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-7">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-600"
					>
						<PackageCheck class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">Technology Brands</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						Manufacturers and brands looking to reach buyers and organizations through TweakMart.
					</p>
				</article>

				<article class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-7">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600"
					>
						<Users class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">Distributors & Providers</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						Distributors, suppliers and service providers who can strengthen our technology
						ecosystem.
					</p>
				</article>

				<article class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-7">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-violet-50 text-violet-600"
					>
						<BadgeCheck class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">Strategic Collaborators</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						Organizations with ideas for integrations, joint offerings or other mutually valuable
						opportunities.
					</p>
				</article>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section id="partnership-form" class="bg-white">
		<div class="mx-auto max-w-[1440px] px-4 py-16 sm:px-6 md:py-24 xl:px-8">
			<div
				class="relative overflow-hidden rounded-[2rem] bg-blue-600 px-6 py-10 text-white sm:px-10 md:px-14 md:py-14"
			>
				<div
					class="pointer-events-none absolute -right-16 -top-24 size-72 rounded-full bg-white/10 blur-2xl"
					aria-hidden="true"
				>
				</div>

				<div class="relative grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-100">
							Let&apos;s talk
						</p>

						<h2 class="mt-3 max-w-2xl text-3xl font-black tracking-tight sm:text-4xl">
							Have a partnership idea?
						</h2>

						<p class="mt-4 max-w-2xl text-sm leading-7 text-blue-100 sm:text-base">
							Tell us who you are, what you do and how you think we can work together.
						</p>
					</div>

					<a
						href="/contact"
						class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-white px-5 text-sm font-bold text-blue-700 transition hover:bg-blue-50"
					>
						Contact TweakMart
						<ArrowRight class="size-4" />
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>
