---
import {
	ArrowRight,
	Building2,
	CircleHelp,
	CreditCard,
	Headphones,
	Package,
	RefreshCcw,
	ShieldCheck,
	Truck,
} from 'lucide-astro';

import Layout from '../layouts/PrimaryLayout.astro';
---

<Layout
	title="Help Centre | TweakMart"
	description="Get help with TweakMart orders, delivery, payments, returns, warranties, products and business purchases."
>
	<!-- Help hero -->
	<section class="border-b border-slate-200 bg-white">
		<div class="mx-auto max-w-[1440px] py-10 sm:px-6 md:py-14 lg:px-8">
			<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500">
				<a href="/" class="transition hover:text-blue-600"> Home</a>

				<span aria-hidden="true">/</span>

				<span class="font-semibold text-slate-900"> Help Centre</span>
			</nav>

			<div
				class="mt-8 grid gap-8 md:grid-cols-[minmax(0,1fr)_320px] md:items-end lg:grid-cols-[minmax(0,1fr)_400px]"
			>
				<div class="max-w-3xl">
					<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
						TweakMart support
					</p>

					<h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl lg:text-5xl">
						What can we help you with?
					</h1>

					<p class="mt-5 max-w-2xl text-sm leading-7 text-slate-600 sm:text-base">
						Find help with your order, payment, delivery, returns, warranty or business technology
						purchase.
					</p>
				</div>

				<div class="rounded-2xl border border-blue-100 bg-blue-50 p-5">
					<div class="flex items-start gap-4">
						<div
							class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-blue-600 text-white"
						>
							<Headphones class="size-5" />
						</div>

						<div>
							<p class="text-sm font-bold text-slate-950">Need personal assistance?</p>

							<p class="mt-1 text-xs leading-5 text-slate-600">
								Our support team can help with questions that aren't covered here.
							</p>

							<a
								href="/technical-support"
								class="mt-3 inline-flex items-center gap-1.5 text-xs font-bold text-blue-700 transition hover:text-blue-900"
							>
								Contact Support
								<ArrowRight class="size-3.5" />
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Help categories -->
	<section>
		<div class="mx-auto max-w-[1440px] py-10 sm:px-6 md:py-14 lg:px-8">
			<div class="max-w-2xl">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">Help topics</p>

				<h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
					Choose a topic
				</h2>

				<p class="mt-2 text-sm leading-6 text-slate-600">
					Start with the area that best matches what you need help with.
				</p>
			</div>

			<div class="mt-8 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
				<!-- Orders -->
				<a
					href="/track-order"
					class="group flex min-h-[190px] flex-col rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg"
				>
					<div
						class="flex size-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition group-hover:bg-blue-600 group-hover:text-white"
					>
						<Package class="size-5" />
					</div>

					<h3 class="mt-5 text-base font-bold text-slate-950">Orders</h3>

					<p class="mt-2 text-sm leading-6 text-slate-500">
						Check an order, understand its status or find information about an existing purchase.
					</p>

					<div class="mt-auto flex items-center gap-1.5 pt-5 text-xs font-bold text-blue-600">
						Order help
						<ArrowRight class="size-3.5 transition-transform group-hover:translate-x-1" />
					</div>
				</a>

				<!-- Delivery -->
				<a
					href="/track-order"
					class="group flex min-h-[190px] flex-col rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg"
				>
					<div
						class="flex size-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition group-hover:bg-blue-600 group-hover:text-white"
					>
						<Truck class="size-5" />
					</div>

					<h3 class="mt-5 text-base font-bold text-slate-950">Delivery & tracking</h3>

					<p class="mt-2 text-sm leading-6 text-slate-500">
						Learn about delivery or check the progress of an order after it has been placed.
					</p>

					<div class="mt-auto flex items-center gap-1.5 pt-5 text-xs font-bold text-blue-600">
						Track an order
						<ArrowRight class="size-3.5 transition-transform group-hover:translate-x-1" />
					</div>
				</a>

				<!-- Payments -->
				<a
					href="/support"
					class="group flex min-h-[190px] flex-col rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg"
				>
					<div
						class="flex size-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition group-hover:bg-blue-600 group-hover:text-white"
					>
						<CreditCard class="size-5" />
					</div>

					<h3 class="mt-5 text-base font-bold text-slate-950">Payments</h3>

					<p class="mt-2 text-sm leading-6 text-slate-500">
						Get help with payment confirmation, failed payments or questions about paying for an
						order.
					</p>

					<div class="mt-auto flex items-center gap-1.5 pt-5 text-xs font-bold text-blue-600">
						Payment help
						<ArrowRight class="size-3.5 transition-transform group-hover:translate-x-1" />
					</div>
				</a>

				<!-- Returns -->
				<a
					href="/returns"
					class="group flex min-h-[190px] flex-col rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg"
				>
					<div
						class="flex size-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition group-hover:bg-blue-600 group-hover:text-white"
					>
						<RefreshCcw class="size-5" />
					</div>

					<h3 class="mt-5 text-base font-bold text-slate-950">Returns & refunds</h3>

					<p class="mt-2 text-sm leading-6 text-slate-500">
						Understand return eligibility, refund processing and what to do when something isn't
						right.
					</p>

					<div class="mt-auto flex items-center gap-1.5 pt-5 text-xs font-bold text-blue-600">
						Returns information
						<ArrowRight class="size-3.5 transition-transform group-hover:translate-x-1" />
					</div>
				</a>

				<!-- Warranty -->
				<a
					href="/warranty"
					class="group flex min-h-[190px] flex-col rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg"
				>
					<div
						class="flex size-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition group-hover:bg-blue-600 group-hover:text-white"
					>
						<ShieldCheck class="size-5" />
					</div>

					<h3 class="mt-5 text-base font-bold text-slate-950">Warranty</h3>

					<p class="mt-2 text-sm leading-6 text-slate-500">
						Find information about warranty coverage, product issues and how to request assistance.
					</p>

					<div class="mt-auto flex items-center gap-1.5 pt-5 text-xs font-bold text-blue-600">
						Warranty help
						<ArrowRight class="size-3.5 transition-transform group-hover:translate-x-1" />
					</div>
				</a>

				<!-- Business -->
				<a
					href="/business"
					class="group flex min-h-[190px] flex-col rounded-2xl border border-slate-200 bg-white p-5 transition duration-200 hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-lg"
				>
					<div
						class="flex size-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600 transition group-hover:bg-blue-600 group-hover:text-white"
					>
						<Building2 class="size-5" />
					</div>

					<h3 class="mt-5 text-base font-bold text-slate-950">Business purchasing</h3>

					<p class="mt-2 text-sm leading-6 text-slate-500">
						Get help with bulk orders, quotations, procurement and technology purchases for your
						organization.
					</p>

					<div class="mt-auto flex items-center gap-1.5 pt-5 text-xs font-bold text-blue-600">
						Business purchasing
						<ArrowRight class="size-3.5 transition-transform group-hover:translate-x-1" />
					</div>
				</a>
			</div>
		</div>
	</section>

	<!-- Support CTA -->
	<section class="border-t border-slate-200 bg-white">
		<div class="mx-auto max-w-[1440px] py-10 sm:px-6 md:py-14 lg:px-8">
			<div class="overflow-hidden rounded-3xl bg-[#000033]">
				<div class="grid md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
					<div class="p-6 sm:p-8 md:p-10">
						<div class="flex size-11 items-center justify-center rounded-xl bg-white/10">
							<CircleHelp class="size-5 text-blue-200" />
						</div>

						<h2 class="mt-5 text-2xl font-bold tracking-tight text-white">Still need help?</h2>

						<p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300">
							Tell us what's happening and our support team will help you find the right next step.
						</p>
					</div>

					<div class="border-t border-white/10 p-6 sm:p-8 md:border-l md:border-t-0 md:p-10">
						<a
							href="/technical-support"
							class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-white px-6 text-sm font-bold text-slate-950 transition hover:bg-blue-50 md:w-auto"
						>
							Contact Support
							<ArrowRight class="size-4" />
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
