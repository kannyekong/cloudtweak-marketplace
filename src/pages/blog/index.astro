---
import { ArrowRight, BookOpen, Sparkles } from 'lucide-astro';

import PrimaryLayout from '../../layouts/PrimaryLayout.astro';
import { getPublishedTweakMartPosts } from '../../lib/tweakmart/blog';

const posts = await getPublishedTweakMartPosts();

const featuredPost = posts.find((post) => post.featured) ?? posts[0] ?? null;

const remainingPosts = featuredPost ? posts.filter((post) => post.id !== featuredPost.id) : [];

const pageTitle = 'TweakMart Blog | Technology Buying Guides & Insights';
const pageDescription =
	'Practical technology buying guides, product insights and advice from TweakMart.';
---

<PrimaryLayout title={pageTitle} description={pageDescription}>
	<!-- Blog content -->
	<section class="mx-auto max-w-full py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
		{
			posts.length === 0 ? (
				<div class="rounded-3xl border border-slate-200 bg-slate-50 px-6 py-16 text-center">
					<div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-white shadow-sm">
						<BookOpen size={30} class="text-slate-400" />
					</div>

					<h2 class="mt-6 text-2xl font-bold tracking-tight text-slate-950">No articles yet</h2>

					<p class="mx-auto mt-3 max-w-xl text-sm leading-7 text-slate-600 sm:text-base">
						We're preparing useful technology insights, buying guides, and product resources for
						TweakMart.
					</p>
				</div>
			) : (
				<>
					{featuredPost && (
						<article class="group overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition duration-500 hover:shadow-xl">
							<div class="grid lg:grid-cols-[1.25fr_0.75fr]">
								<a
									href={`/blog/${featuredPost.slug}`}
									class="group relative block min-h-[280px] overflow-hidden bg-slate-100 sm:min-h-[360px] lg:min-h-[430px]"
								>
									{featuredPost.cover_image ? (
										<>
											<img
												src={featuredPost.cover_image}
												alt={featuredPost.title}
												width="1200"
												height="675"
												loading="eager"
												fetchpriority="high"
												class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
											/>

											<div class="absolute inset-0 bg-black/30" aria-hidden="true" />

											<div
												class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/60 to-black/25"
												aria-hidden="true"
											/>
										</>
									) : (
										<div class="flex h-full min-h-[280px] items-center justify-center bg-slate-50 sm:min-h-[360px]">
											<BookOpen size={40} class="text-slate-300" />
										</div>
									)}

									<div class="absolute left-5 top-5 inline-flex items-center gap-2 rounded-full border border-white/20 bg-black/35 px-3 py-1.5 text-xs font-bold uppercase tracking-wide text-white backdrop-blur-md">
										<Sparkles size={13} />
										Featured
									</div>

									<div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 lg:hidden">
										<span class="inline-flex rounded-full bg-white/15 px-3 py-1 text-xs font-bold text-white backdrop-blur-md">
											{featuredPost.category ?? 'General'}
										</span>

										<h2 class="mt-3 text-2xl font-bold leading-tight text-white sm:text-3xl">
											{featuredPost.title}
										</h2>
									</div>
								</a>

								<div class="flex flex-col justify-center p-6 sm:p-8 lg:p-10">
									<div class="flex flex-wrap items-center gap-3">
										<span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">
											{featuredPost.category ?? 'General'}
										</span>

										<span class="text-xs font-medium text-slate-400">
											{new Intl.DateTimeFormat('en-NG', {
												day: 'numeric',
												month: 'short',
												year: 'numeric',
											}).format(new Date(featuredPost.published_at ?? featuredPost.created_at))}
										</span>
									</div>

									<h2 class="mt-5 text-2xl font-bold leading-tight tracking-tight text-slate-950 sm:text-3xl lg:text-4xl">
										<a
											href={`/blog/${featuredPost.slug}`}
											class="transition-colors hover:text-blue-600"
										>
											{featuredPost.title}
										</a>
									</h2>

									{featuredPost.excerpt && (
										<p class="mt-4 text-sm leading-7 text-slate-600 sm:text-base">
											{featuredPost.excerpt}
										</p>
									)}

									<a
										href={`/blog/${featuredPost.slug}`}
										class="mt-7 inline-flex w-fit items-center gap-2 rounded-full bg-blue-600 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-blue-700"
									>
										Read featured article
										<ArrowRight
											size={16}
											class="transition-transform duration-300 group-hover:translate-x-1"
										/>
									</a>
								</div>
							</div>
						</article>
					)}

					{remainingPosts.length > 0 && (
						<div class="mt-14">
							<div class="mb-7">
								<p class="text-sm font-bold text-blue-600">Latest insights</p>

								<h2 class="mt-1 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
									Explore the latest from TweakMart
								</h2>
							</div>

							<div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
								{remainingPosts.map((post) => (
									<article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white transition duration-300 hover:-translate-y-1 hover:shadow-lg">
										<a
											href={`/blog/${post.slug}`}
											class="relative block overflow-hidden bg-slate-100"
										>
											{post.cover_image ? (
												<>
													<img
														src={post.cover_image}
														alt={post.title}
														width="600"
														height="338"
														loading="lazy"
														class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-105"
													/>

													<div class="absolute inset-0 bg-black/20" aria-hidden="true" />
												</>
											) : (
												<div class="flex aspect-[16/9] items-center justify-center bg-slate-50">
													<BookOpen size={34} class="text-slate-300" />
												</div>
											)}
										</a>

										<div class="flex flex-1 flex-col p-5">
											<div class="flex items-center justify-between gap-3">
												<span class="text-xs font-bold text-blue-600">
													{post.category ?? 'General'}
												</span>

												<span class="text-xs text-slate-400">
													{new Intl.DateTimeFormat('en-NG', {
														day: 'numeric',
														month: 'short',
														year: 'numeric',
													}).format(new Date(post.published_at ?? post.created_at))}
												</span>
											</div>

											<h3 class="mt-3 line-clamp-2 text-lg font-bold leading-6 text-slate-950">
												<a href={`/blog/${post.slug}`} class="transition group-hover:text-blue-600">
													{post.title}
												</a>
											</h3>

											{post.excerpt && (
												<p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600">
													{post.excerpt}
												</p>
											)}

											<a
												href={`/blog/${post.slug}`}
												class="mt-auto inline-flex items-center gap-2 pt-5 text-sm font-bold text-blue-600 transition hover:gap-3"
											>
												Read article
												<ArrowRight size={16} />
											</a>
										</div>
									</article>
								))}
							</div>
						</div>
					)}
				</>
			)
		}
	</section>
</PrimaryLayout>
