---
import { ChevronDown, PackageSearch } from 'lucide-astro';

import Layout from '../../layouts/PrimaryLayout.astro';
import ProductCard from '~/components/storefront/ProductCard.astro';

import {
	getStorefrontProducts,
	type StorefrontProductSort,
} from '../../lib/tweakmart/storefront-products';

const requestedSort = Astro.url.searchParams.get('sort');

const allowedSorts: StorefrontProductSort[] = ['recommended', 'price-asc', 'price-desc', 'newest'];

/* Validates the requested sorting mode before passing it to the product service. */
const sort: StorefrontProductSort = allowedSorts.includes(requestedSort as StorefrontProductSort)
	? (requestedSort as StorefrontProductSort)
	: 'recommended';

/* Loads all active and published TweakMart products using the selected sorting mode. */
const products = await getStorefrontProducts({
	sort,
	limit: 100,
});

const sortLabels: Record<StorefrontProductSort, string> = {
	recommended: 'Recommended',
	'price-asc': 'Price: Low to High',
	'price-desc': 'Price: High to Low',
	newest: 'Newest',
};
---

<Layout
	title="All Products | TweakMart"
	description="Browse technology products, software, devices, accessories and more available from TweakMart."
>
	<main class="min-h-screen bg-white">
		<section class="border-b border-slate-200">
			<div class="mx-auto max-w-[1440px] py-8 sm:px-6 lg:px-8 lg:py-12">
				<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500">
					<a href="/" class="transition hover:text-blue-600"> Home</a>

					<span aria-hidden="true">/</span>

					<span class="font-semibold text-slate-900"> Products</span>
				</nav>

				<div class="mt-7 max-w-3xl">
					<h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
						Explore all products
					</h1>

					<p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600">
						Browse our complete collection of technology products, software, devices and solutions
						available on TweakMart.
					</p>
				</div>
			</div>
		</section>

		<section class="mx-auto max-w-[1440px] py-8 sm:px-6 lg:px-8 lg:py-10">
			<div class="grid gap-8 lg:grid-cols-[220px_minmax(0,1fr)]">
				<aside class="hidden lg:block">
					<div class="sticky top-6 rounded-2xl border border-slate-200 bg-white p-5">
						<div class="border-b border-slate-200 pb-4">
							<p class="text-xs font-bold uppercase tracking-wide text-slate-400">Products</p>

							<h2 class="mt-1 text-sm font-bold text-slate-950">All products</h2>

							<p class="mt-1 text-xs text-slate-500">
								{products.length === 1 ? '1 product' : `${products.length} products`}
							</p>
						</div>

						<div class="mt-5">
							<p class="text-xs font-bold uppercase tracking-wide text-slate-400">Sort by</p>

							<nav aria-label="Sort products" class="mt-3 space-y-1">
								{
									Object.entries(sortLabels).map(([value, label]) => (
										<a
											href={`/products?sort=${value}`}
											class:list={[
												'block rounded-xl px-3 py-2.5 text-sm font-semibold transition',
												sort === value
													? 'bg-blue-50 text-blue-600'
													: 'text-slate-600 hover:bg-slate-50 hover:text-slate-950',
											]}
										>
											{label}
										</a>
									))
								}
							</nav>
						</div>

						<div class="mt-6 border-t border-slate-200 pt-5">
							<a
								href="/collections"
								class="text-xs font-bold text-blue-600 transition hover:text-blue-700"
							>
								Browse by category
							</a>
						</div>
					</div>
				</aside>

				<div class="min-w-0">
					<div
						class="mb-6 flex flex-col gap-4 border-b border-slate-200 pb-5 sm:flex-row sm:items-center sm:justify-between"
					>
						<div>
							<h2 class="text-lg font-bold text-slate-950">All products</h2>

							<p class="mt-1 text-xs text-slate-500">
								{products.length === 1 ? '1 product' : `${products.length} products`}
							</p>
						</div>

						<form method="get" class="relative lg:hidden" data-product-sort-form>
							<label for="product-sort" class="sr-only"> Sort products</label>

							<select
								id="product-sort"
								name="sort"
								class="h-11 w-full min-w-56 appearance-none rounded-xl border border-slate-200 bg-white py-2 pl-3 pr-10 text-sm font-semibold text-slate-700 outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10 sm:w-auto"
								data-product-sort
							>
								{
									Object.entries(sortLabels).map(([value, label]) => (
										<option value={value} selected={sort === value}>
											{label}
										</option>
									))
								}
							</select>

							<ChevronDown
								class="pointer-events-none absolute right-3 top-1/2 size-4 -translate-y-1/2 text-slate-400"
							/>
						</form>
					</div>

					{
						products.length === 0 ? (
							<div class="flex min-h-[420px] flex-col items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 text-center">
								<div class="flex size-14 items-center justify-center rounded-2xl bg-white shadow-sm">
									<PackageSearch class="size-6 text-slate-400" />
								</div>

								<h2 class="mt-5 text-lg font-bold text-slate-950">No products available</h2>

								<p class="mt-2 max-w-md text-sm leading-6 text-slate-500">
									There are currently no published products available on TweakMart.
								</p>

								<a
									href="/collections"
									class="mt-6 inline-flex min-h-11 items-center justify-center rounded-xl bg-blue-600 px-5 text-sm font-bold text-white transition hover:bg-blue-700"
								>
									Browse categories
								</a>
							</div>
						) : (
							<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
								{products.map((product) => (
									<ProductCard {...product} class="min-w-0" />
								))}
							</div>
						)
					}
				</div>
			</div>
		</section>
	</main>
</Layout>

<script>
	/** Submits the product sorting form whenever the visitor changes the selected sorting mode. */
	function initializeProductSort() {
		const sort = document.querySelector<HTMLSelectElement>('[data-product-sort]');

		const form = document.querySelector<HTMLFormElement>('[data-product-sort-form]');

		if (!sort || !form) {
			return;
		}

		/* Prevents duplicate listeners after Astro client-side navigation. */
		if (sort.dataset.initialized === 'true') {
			return;
		}

		sort.dataset.initialized = 'true';

		sort.addEventListener('change', () => {
			form.requestSubmit();
		});
	}

	/** Initializes client-side interactions for the all-products page. */
	function initializeProductsPage() {
		initializeProductSort();
	}

	document.addEventListener('astro:page-load', initializeProductsPage);

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initializeProductsPage, {
			once: true,
		});
	} else {
		initializeProductsPage();
	}
</script>
