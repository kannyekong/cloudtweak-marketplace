---
import Layout from '~/layouts/PrimaryLayout.astro';

import ProductPurchasePanel from '~/features/product/ProductsPurchasePanel.tsx';

import { getStorefrontProductBySlug } from '../../lib/tweakmart/storefront-products';
import { ShieldCheck } from 'lucide-astro';

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect('/');
}

/* Loads the active published product matching the requested storefront slug. */
const product = await getStorefrontProductBySlug(slug);

if (!product) {
	return new Response(null, {
		status: 404,
		statusText: 'Product not found',
	});
}

/* Converts product specifications into renderable key/value entries. */
const specifications = Object.entries(product.specifications);

/* Determines the initial image displayed in the main product gallery. */
const mainImage = product.primary_image ?? product.images[0] ?? null;

const productTypeLabel =
	product.product_type === 'digital'
		? 'Digital product'
		: product.product_type === 'service'
			? 'Service'
			: 'Physical product';

const conditionLabel = product.condition === 'new' ? 'Brand new' : product.condition;

const pageDescription =
	product.short_description ?? product.description ?? `${product.name} available on TweakMart.`;
---

<Layout title={`${product.name} | TweakMart`} description={pageDescription}>
	<main class="min-h-screen bg-white text-slate-950">
		<div class="mx-auto max-w-7xl py-6 sm:px-6 lg:px-8 lg:py-10">
			<nav
				aria-label="Breadcrumb"
				class="mb-7 flex flex-wrap items-center gap-2 text-xs font-medium text-slate-500 dark:text-slate-400"
			>
				<a href="/" class="hover:text-primary transition"> Home</a>

				<span aria-hidden="true" class="text-slate-300"> /</span>

				{
					product.category && (
						<>
							<a href={`/collections/${product.category.slug}`}>
								<span class="hover:text-primary transition">{product.category.name}</span>
							</a>

							<span aria-hidden="true" class="text-slate-300">
								/
							</span>
						</>
					)
				}

				<span class="max-w-xs truncate text-slate-900">
					{product.name}
				</span>
			</nav>

			<section class="grid gap-10 lg:grid-cols-[minmax(0,1.08fr)_minmax(360px,0.92fr)] lg:gap-14">
				<div class="min-w-0">
					<div
						class="relative overflow-hidden rounded-[2rem] border border-slate-200/80 bg-slate-50"
					>
						<div class="relative aspect-square sm:aspect-[6/5]">
							{
								mainImage ? (
									<img
										id="tweakmart-main-product-image"
										src={mainImage.image_url}
										alt={mainImage.alt_text ?? product.name}
										loading="eager"
										class="h-full w-full object-contain p-8 transition-opacity duration-200 sm:p-12 lg:p-16"
									/>
								) : (
									<div class="flex h-full w-full items-center justify-center p-10 text-center">
										<div>
											<svg
												viewBox="0 0 24 24"
												fill="none"
												aria-hidden="true"
												class="mx-auto h-12 w-12 text-slate-300"
											>
												<path
													d="M4 7.75A2.75 2.75 0 0 1 6.75 5h10.5A2.75 2.75 0 0 1 20 7.75v8.5A2.75 2.75 0 0 1 17.25 19H6.75A2.75 2.75 0 0 1 4 16.25v-8.5Z"
													stroke="currentColor"
													stroke-width="1.5"
												/>

												<path
													d="m5 16 4.2-4.2a1.5 1.5 0 0 1 2.12 0L13 13.48l1.18-1.18a1.5 1.5 0 0 1 2.12 0L20 16"
													stroke="currentColor"
													stroke-width="1.5"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>

											<p class="mt-3 text-sm font-medium text-slate-400">
												Product image unavailable
											</p>
										</div>
									</div>
								)
							}

							<div
								class="pointer-events-none absolute left-4 top-4 flex flex-wrap gap-2 sm:left-5 sm:top-5"
							>
								{
									product.featured && (
										<span class="rounded-full border border-white/70 bg-white/90 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-800 shadow-sm backdrop-blur-md">
											Featured
										</span>
									)
								}
							</div>
						</div>
					</div>

					{
						product.images.length > 1 && (
							<div class="mt-4 flex gap-3 overflow-x-auto pb-2">
								{product.images.map((image, index) => (
									<button
										type="button"
										class:list={[
											'product-thumbnail relative h-20 w-20 shrink-0 overflow-hidden rounded-xl border bg-slate-50 transition sm:h-24 sm:w-24',
											image.id === mainImage?.id
												? 'border-primary ring-primary/10 ring-2'
												: 'border-slate-200 hover:border-slate-400',
										]}
										data-product-image={image.image_url}
										data-product-alt={image.alt_text ?? product.name}
										aria-label={`View image ${index + 1} of ${product.name}`}
									>
										<img
											src={image.image_url}
											alt=""
											loading="lazy"
											class="h-full w-full object-contain p-2"
										/>
									</button>
								))}
							</div>
						)
					}
				</div>

				<div class="min-w-0 lg:pt-2">
					<div
						class="flex flex-wrap items-center gap-2 text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400 dark:text-slate-500"
					>
						{product.brand && <span class="text-primary">{product.brand.name}</span>}

						{
							product.brand && product.category && (
								<span class="h-1 w-1 rounded-full bg-slate-300" />
							)
						}

						{product.category && <span>{product.category.name}</span>}
					</div>

					<h1
						class="mt-4 max-w-2xl text-3xl font-bold leading-[1.12] tracking-[-0.035em] text-slate-950 sm:text-4xl lg:text-[2.7rem]"
					>
						{product.name}
					</h1>

					{
						product.short_description && (
							<p class="mt-4 max-w-xl text-sm leading-7 text-slate-500 sm:text-[15px]">
								{product.short_description}
							</p>
						)
					}

					<div class="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-3">
						<div
							class="rounded-xl border border-slate-200/80 bg-slate-50/70 px-3.5 py-3"
						>
							<p class="text-[9px] font-bold uppercase tracking-[0.12em] text-slate-800">
								Availability
							</p>

							<div class="mt-1.5 flex items-center gap-2">
								<span
									class:list={[
										'h-1.5 w-1.5 rounded-full',
										product.inventory.in_stock ? 'bg-emerald-500' : 'bg-rose-500',
									]}
								>
								</span>

								<span
									class:list={[
										'text-xs font-semibold',
										product.inventory.in_stock
											? 'text-emerald-600 dark:text-emerald-400'
											: 'text-rose-600 dark:text-rose-400',
									]}
								>
									{product.inventory.in_stock ? 'In stock' : 'Unavailable'}
								</span>
							</div>
						</div>

						<div
							class="rounded-xl border border-slate-200/80 bg-slate-50/70 px-3.5 py-3"
						>
							<p class="text-[9px] font-bold uppercase tracking-[0.12em] text-black">Type</p>

							<p class="mt-1.5 text-xs font-semibold text-slate-800">
								{productTypeLabel}
							</p>
						</div>

						<div
							class="col-span-2 rounded-xl border border-slate-200/80 bg-slate-50/70 px-3.5 py-3 sm:col-span-1"
						>
							<p class="text-[9px] font-bold uppercase tracking-[0.12em] text-slate-400">
								Condition
							</p>

							<p class="mt-1.5 text-xs font-semibold capitalize text-slate-800">
								{conditionLabel}
							</p>
						</div>
					</div>

					<div class="mt-7">
						<ProductPurchasePanel product={product} client:load />
					</div>

					<div
						class="mt-8 rounded-2xl border border-slate-200 bg-green-100 p-4"
					>
						<div class="flex gap-3">
							<div
								class="text-primary flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-green-50 shadow-sm"
							>
								<ShieldCheck className="text-green-500" />
							</div>

							<div>
								<p class="text-xs font-semibold text-slate-900">
									Sold by TweakMart
								</p>

								<p class="mt-1 text-[11px] leading-5 text-slate-500 dark:text-slate-400">
									A CloudTweak Technologies Limited product marketplace.
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			{
				product.description || specifications.length > 0 ? (
					<section class="mt-16 border-t border-slate-200 pt-12 lg:mt-20 lg:pt-16">
						<div class="grid gap-12 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-20">
							{product.description && (
								<div>
									<p class="text-primary text-[10px] font-bold uppercase tracking-[0.15em]">
										Product details
									</p>

									<h2 class="mt-3 text-2xl font-bold tracking-[-0.025em] text-slate-950">
										About this product
									</h2>

									<div class="mt-5 whitespace-pre-line text-sm leading-7 text-slate-600">
										{product.description}
									</div>
								</div>
							)}

							{specifications.length > 0 && (
								<div>
									<p class="text-primary text-[10px] font-bold uppercase tracking-[0.15em]">
										Technical information
									</p>

									<h2 class="mt-3 text-2xl font-bold tracking-[-0.025em] text-slate-950 dark:text-white">
										Specifications
									</h2>

									<dl class="mt-5 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-800">
										{specifications.map(([key, value]) => (
											<div class="grid grid-cols-[minmax(100px,0.7fr)_minmax(0,1.3fr)] gap-4 border-b border-slate-100 px-4 py-3.5 last:border-b-0 dark:border-slate-800">
												<dt class="text-xs font-semibold capitalize text-slate-500 dark:text-slate-400">
													{key.replaceAll('_', ' ')}
												</dt>

												<dd class="text-right text-xs font-medium text-slate-900 dark:text-slate-200">
													{typeof value === 'object' ? JSON.stringify(value) : String(value)}
												</dd>
											</div>
										))}
									</dl>
								</div>
							)}
						</div>
					</section>
				) : null
			}
		</div>
	</main>
</Layout>

<script>
	/* Changes the main product image when a gallery thumbnail is selected. */
	function initializeProductGallery() {
		const mainImage = document.querySelector<HTMLImageElement>('#tweakmart-main-product-image');

		const thumbnails = document.querySelectorAll<HTMLButtonElement>('.product-thumbnail');

		if (!mainImage) {
			return;
		}

		thumbnails.forEach((thumbnail) => {
			thumbnail.addEventListener('click', () => {
				const imageUrl = thumbnail.dataset.productImage;

				const imageAlt = thumbnail.dataset.productAlt;

				if (!imageUrl) {
					return;
				}

				mainImage.src = imageUrl;

				mainImage.alt = imageAlt ?? 'Product image';

				thumbnails.forEach((item) => {
					item.classList.remove('border-primary', 'ring-2', 'ring-primary/10');

					item.classList.add('border-slate-200', 'dark:border-slate-800');
				});

				thumbnail.classList.remove('border-slate-200', 'dark:border-slate-800');

				thumbnail.classList.add('border-primary', 'ring-2', 'ring-primary/10');
			});
		});
	}

	/* Initializes product gallery interactions after Astro navigation. */
	document.addEventListener('astro:page-load', initializeProductGallery);

	initializeProductGallery();
</script>
