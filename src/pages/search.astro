---
import { ArrowRight, PackageSearch, Search } from 'lucide-astro';

import Layout from '../layouts/PrimaryLayout.astro';
import ProductCard from '~/components/storefront/ProductCard.astro';
import CategoryCard from '~/components/storefront/CategoryCard.astro';

import {
	getStorefrontProducts,
	type StorefrontProduct,
} from '../lib/tweakmart/storefront-products';

import {
	searchStorefrontCategories,
	type StorefrontCategory,
} from '../lib/tweakmart/storefront-categories';

const query = Astro.url.searchParams.get('q')?.trim() ?? '';

let products: StorefrontProduct[] = [];
let categories: StorefrontCategory[] = [];

/* Runs storefront searches only when the customer has entered a search term. */
if (query) {
	[products, categories] = await Promise.all([
		getStorefrontProducts({
			search: query,
			sort: 'recommended',
			limit: 24,
		}),
		searchStorefrontCategories(query, 6),
	]);
}

const totalResults = products.length + categories.length;
---

<Layout
	title={query ? `Search results for "${query}" | TweakMart` : 'Search | TweakMart'}
	description="Search TweakMart products, software, technology and product categories."
>
	<main class="min-h-screen bg-white">
		<section class="border-b border-slate-200">
			<div class="mx-auto max-w-[1440px] py-8 sm:px-6 lg:px-8 lg:py-10">
				<div class="max-w-3xl">
					<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
						TweakMart Search
					</p>

					<h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
						{query ? 'Search results' : 'Search TweakMart'}
					</h1>

					{
						query ? (
							<p class="mt-3 text-sm leading-6 text-slate-600">
								Showing results for <span class="font-bold text-slate-950">“{query}”</span>
							</p>
						) : (
							<p class="mt-3 text-sm leading-6 text-slate-600">
								Search products, software, brands and categories available on TweakMart.
							</p>
						)
					}

					<form action="/search" method="get" role="search" class="relative mt-6 max-w-2xl">
						<label for="search-page-query" class="sr-only"> Search TweakMart</label>

						<Search
							class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-slate-400"
						/>

						<input
							id="search-page-query"
							name="q"
							type="search"
							value={query}
							autocomplete="off"
							placeholder="Search products, software and categories..."
							class="h-12 w-full rounded-xl border border-slate-300 bg-white pl-12 pr-24 text-sm text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/10"
						/>

						<button
							type="submit"
							class="absolute right-1.5 top-1/2 h-9 -translate-y-1/2 rounded-lg bg-pink-500 px-4 text-sm font-bold text-white transition hover:bg-blue-600"
						>
							Search
						</button>
					</form>
				</div>
			</div>
		</section>

		{
			!query ? (
				<section class="mx-auto max-w-[1440px] px-4 py-12 sm:px-6 lg:px-8">
					<div class="flex min-h-[320px] flex-col items-center justify-center text-center">
						<div class="flex size-14 items-center justify-center rounded-2xl bg-slate-100">
							<Search class="size-6 text-slate-400" />
						</div>

						<h2 class="mt-5 text-lg font-bold text-slate-950">What are you looking for?</h2>

						<p class="mt-2 max-w-md text-sm leading-6 text-slate-500">
							Enter a product, software solution or category to start searching TweakMart.
						</p>
					</div>
				</section>
			) : totalResults === 0 ? (
				<section class="mx-auto max-w-[1440px] px-4 py-12 sm:px-6 lg:px-8">
					<div class="flex min-h-[360px] flex-col items-center justify-center rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 text-center">
						<div class="flex size-14 items-center justify-center rounded-2xl bg-white shadow-sm">
							<PackageSearch class="size-6 text-slate-400" />
						</div>

						<h2 class="mt-5 text-lg font-bold text-slate-950">No results found</h2>

						<p class="mt-2 max-w-md text-sm leading-6 text-slate-500">
							We couldn't find anything matching “{query}”. Try another product name, category or
							keyword.
						</p>

						<a
							href="/products"
							class="mt-6 inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 text-sm font-bold text-white transition hover:bg-blue-700"
						>
							Browse all products
							<ArrowRight class="size-4" />
						</a>
					</div>
				</section>
			) : (
				<div class="mx-auto max-w-[1440px] space-y-12 px-4 py-8 sm:px-6 lg:px-8 lg:py-10">
					{categories.length > 0 && (
						<section aria-labelledby="category-results-heading">
							<div class="mb-6 flex items-end justify-between gap-4">
								<div>
									<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
										Categories
									</p>

									<h2 id="category-results-heading" class="mt-1 text-xl font-bold text-slate-950">
										Matching categories
									</h2>
								</div>

								<a
									href="/collections"
									class="hidden items-center gap-2 text-sm font-bold text-blue-600 transition hover:text-blue-700 sm:flex"
								>
									All categories
									<ArrowRight class="size-4" />
								</a>
							</div>

							<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4">
								{categories.map((category) => (
									<CategoryCard
										name={category.name}
										slug={category.slug}
										description={category.description}
										imageUrl={category.image_url}
										featured={category.featured}
									/>
								))}
							</div>
						</section>
					)}

					{products.length > 0 && (
						<section aria-labelledby="product-results-heading">
							<div class="mb-6">
								<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">Products</p>

								<div class="mt-1 flex items-center justify-between gap-4">
									<h2 id="product-results-heading" class="text-xl font-bold text-slate-950">
										Matching products
									</h2>

									<span class="text-xs font-semibold text-slate-500">
										{products.length} {products.length === 1 ? 'product' : 'products'}
									</span>
								</div>
							</div>

							<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4">
								{products.map((product) => (
									<ProductCard {...product} class="min-w-0" />
								))}
							</div>
						</section>
					)}
				</div>
			)
		}
	</main>
</Layout>
