---
import { Heart } from 'lucide-astro';

import SavedItemsPage from '../features/wishlist/SavedItemsPage';
import Layout from '../layouts/PrimaryLayout.astro';
---

<Layout
	title="Saved Items | TweakMart"
	description="View products you've saved on TweakMart and return to them whenever you're ready."
>
	<section class="border-b border-slate-200 bg-white">
		<div class="mx-auto max-w-[1440px] py-10 sm:px-6 md:py-12 lg:px-8">
			<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500">
				<a href="/" class="transition hover:text-blue-600"> Home</a>

				<span aria-hidden="true">/</span>

				<span class="font-semibold text-slate-900"> Saved Items</span>
			</nav>

			<div class="mt-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">Your Wishlist</p>

					<h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
						Saved Items
					</h1>

					<p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600 sm:text-base">
						Keep the products you're interested in close by while you compare options or decide what
						to purchase.
					</p>
				</div>

				<div class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-blue-50">
					<Heart class="size-6 text-blue-600" />
				</div>
			</div>
		</div>
	</section>

	<section>
		<div class="mx-auto max-w-[1440px] py-10 sm:px-6 md:py-12 lg:px-8">
			<SavedItemsPage client:load />
		</div>
	</section>
</Layout>
