---
import {
	ArrowRight,
	BadgeCheck,
	Boxes,
	Building2,
	CheckCircle2,
	Headphones,
	ShieldCheck,
	ShoppingBag,
	Truck,
	Users,
} from 'lucide-astro';

import Layout from '../layouts/PrimaryLayout.astro';
---

<Layout
	title="Who We Are | TweakMart"
	description="TweakMart is a CloudTweak technology commerce product built to simplify technology purchasing, sourcing and support for individuals and organizations."
>
	<!-- What we do -->
	<section class="border-y border-slate-200">
		<div class="mx-auto max-w-[1440px] py-16 sm:px-6 md:py-24 xl:px-8">
			<div class="max-w-2xl">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
					What TweakMart does
				</p>

				<h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
					One commerce platform. Multiple ways to get technology moving.
				</h2>

				<p class="mt-4 text-base leading-7 text-slate-600">
					TweakMart supports both everyday technology purchases and more involved organizational
					requirements. Whether you&apos;re buying a single device, equipping a growing team or
					sourcing technology for a larger organization, TweakMart is designed to make the journey
					from requirement to delivery more straightforward.
				</p>
			</div>

			<div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
				<article class="rounded-3xl border border-slate-200 bg-white p-6">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-600"
					>
						<ShoppingBag class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">Shop Technology</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						Discover and purchase technology products through a modern, focused commerce experience.
					</p>
				</article>

				<article class="rounded-3xl border border-slate-200 bg-white p-6">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-violet-50 text-violet-600"
					>
						<Boxes class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">Bulk Orders</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						Purchase technology at organizational scale with sourcing, pricing and delivery
						coordination.
					</p>
				</article>

				<article class="rounded-3xl border border-slate-200 bg-white p-6">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-amber-50 text-amber-600"
					>
						<Building2 class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">Business Sourcing</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						Tell us what your organization needs and request a custom quotation for specific
						requirements.
					</p>
				</article>

				<article class="rounded-3xl border border-slate-200 bg-white p-6">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600"
					>
						<Headphones class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">Technical Support</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						Get support for installation, configuration, deployment and technology implementation.
					</p>
				</article>
			</div>
		</div>
	</section>

	<!-- Visual story -->
	<section class="bg-white">
		<div
			class="mx-auto grid max-w-[1440px] gap-12 py-16 sm:px-6 md:grid-cols-2 md:items-center md:py-24 xl:px-8"
		>
			<div class="relative overflow-hidden p-3">
				<img
					src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1400&q=85"
					alt="Team collaborating in a modern technology workspace"
					class="aspect-[4/3] w-full rounded-xl object-cover"
					loading="lazy"
				/>

				<div class="absolute bottom-7 left-7 max-w-xs rounded-2xl bg-white p-4 shadow-xl">
					<div class="flex items-center gap-3">
						<div
							class="flex size-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600"
						>
							<Users class="size-4" />
						</div>

						<div>
							<p class="text-xs font-bold text-slate-950">Built for real purchasing needs</p>

							<p class="mt-1 text-[11px] text-slate-500">Individuals, teams and organizations</p>
						</div>
					</div>
				</div>
			</div>

			<div>
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">Why we built it</p>

				<h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
					Technology buying shouldn&apos;t end at “Add to cart”.
				</h2>

				<p class="mt-5 text-base leading-8 text-slate-600">
					The right technology purchase is often connected to a much bigger requirement:
					compatibility, licensing, deployment, configuration, infrastructure, support or future
					growth.
				</p>

				<p class="mt-5 text-base leading-8 text-slate-600">
					TweakMart was created to bridge that gap. We combine the convenience of e-commerce with
					access to CloudTweak&apos;s technology experience so customers can move from buying
					technology to actually using it effectively.
				</p>

				<div class="mt-7 space-y-3">
					<div class="flex items-start gap-3">
						<CheckCircle2 class="mt-0.5 size-5 shrink-0 text-blue-600" />

						<p class="text-sm leading-6 text-slate-700">
							Purchase technology through a simple storefront.
						</p>
					</div>

					<div class="flex items-start gap-3">
						<CheckCircle2 class="mt-0.5 size-5 shrink-0 text-blue-600" />

						<p class="text-sm leading-6 text-slate-700">
							Request sourcing when your needs go beyond the catalogue.
						</p>
					</div>

					<div class="flex items-start gap-3">
						<CheckCircle2 class="mt-0.5 size-5 shrink-0 text-blue-600" />

						<p class="text-sm leading-6 text-slate-700">
							Connect purchases with technical implementation and support.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Principles -->
	<section class="bg-slate-50">
		<div class="mx-auto max-w-[1440px] py-16 sm:px-6 md:py-24 xl:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">How we think</p>

				<h2 class="mt-3 text-3xl font-black tracking-tight text-slate-950 sm:text-4xl">
					Built around a better technology buying experience.
				</h2>
			</div>

			<div class="mt-10 grid gap-4 md:grid-cols-3">
				<article class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-7">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-600"
					>
						<BadgeCheck class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">Clearer choices</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						We want technology purchasing to feel understandable, focused and relevant instead of
						unnecessarily complicated.
					</p>
				</article>

				<article class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-7">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600"
					>
						<ShieldCheck class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">Practical expertise</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						Technology should be useful in the real environment where it will operate, not simply
						attractive on a product page.
					</p>
				</article>

				<article class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-7">
					<div
						class="flex size-12 items-center justify-center rounded-2xl bg-violet-50 text-violet-600"
					>
						<Truck class="size-5" />
					</div>

					<h3 class="mt-5 text-lg font-black text-slate-950">End-to-end thinking</h3>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						From finding a product to sourcing, delivery and support, we think beyond the initial
						transaction.
					</p>
				</article>
			</div>
		</div>
	</section>

	<!-- CTA -->
	<section class="bg-white">
		<div class="mx-auto max-w-[1440px] py-16 sm:px-6 md:py-24 xl:px-8">
			<div
				class="relative overflow-hidden rounded-[2rem] bg-blue-600 px-6 py-10 text-white sm:px-10 md:px-14 md:py-14"
			>
				<div
					class="pointer-events-none absolute -right-16 -top-24 size-72 rounded-full bg-white/10 blur-2xl"
					aria-hidden="true"
				>
				</div>

				<div class="relative grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-100">
							Start with TweakMart
						</p>

						<h2 class="mt-3 max-w-2xl text-3xl font-black tracking-tight sm:text-4xl">
							Find the technology you need. We&apos;ll help with the rest.
						</h2>

						<p class="mt-4 max-w-2xl text-sm leading-7 text-blue-100 sm:text-base">
							Shop directly, request bulk purchasing or tell us what your organization is looking
							for.
						</p>
					</div>

					<div class="flex flex-col gap-3 sm:flex-row md:flex-col lg:flex-row">
						<a
							href="/products"
							class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-white px-5 text-sm font-bold text-blue-700 transition hover:bg-blue-50"
						>
							Shop TweakMart
							<ArrowRight class="size-4" />
						</a>

						<a
							href="/bulk-orders"
							class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/25 bg-white/10 px-5 text-sm font-bold text-white transition hover:bg-white/15"
						>
							Bulk Orders
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
