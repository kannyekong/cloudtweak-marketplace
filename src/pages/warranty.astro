---
import {
	ArrowRight,
	BadgeCheck,
	Box,
	CheckCircle2,
	CircleHelp,
	FileCheck2,
	Headphones,
	PackageCheck,
	ShieldCheck,
	Wrench,
	XCircle,
} from 'lucide-astro';

import Layout from '../layouts/PrimaryLayout.astro';
---

<Layout
	title="Warranty | TweakMart"
	description="Learn about warranty coverage for products purchased from TweakMart and how to get support when a product develops a fault."
>
	<!-- Warranty hero -->
	<section class="border-b border-slate-200 bg-white">
		<div class="mx-auto max-w-[1440px] py-10 sm:px-6 md:py-14 lg:px-8">
			<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500">
				<a href="/" class="transition hover:text-blue-600"> Home</a>

				<span aria-hidden="true">/</span>

				<a href="/help" class="transition hover:text-blue-600"> Help</a>

				<span aria-hidden="true">/</span>

				<span class="font-semibold text-slate-900"> Warranty</span>
			</nav>

			<div
				class="mt-8 grid gap-8 md:grid-cols-[minmax(0,1fr)_360px] md:items-end lg:grid-cols-[minmax(0,1fr)_420px]"
			>
				<div class="max-w-3xl">
					<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
						Product warranty
					</p>

					<h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl lg:text-5xl">
						Support when your technology
						<span class="text-slate-400">
							{' '}needs attention.
						</span>
					</h1>

					<p class="mt-5 max-w-2xl text-sm leading-7 text-slate-600 sm:text-base">
						If a product purchased from TweakMart develops a fault, we'll help you understand the
						applicable warranty and the next steps available to you.
					</p>
				</div>

				<div class="rounded-2xl border border-blue-100 bg-blue-50 p-5">
					<div class="flex items-start gap-4">
						<div
							class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-blue-600 text-white"
						>
							<ShieldCheck class="size-5" />
						</div>

						<div>
							<p class="text-sm font-bold text-slate-950">Coverage can vary</p>

							<p class="mt-1 text-xs leading-5 text-slate-600">
								Warranty terms may differ by product, manufacturer and supplier. Check the
								information provided with your product or contact us for help.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Warranty overview -->
	<section>
		<div class="mx-auto max-w-[1440px] py-10 sm:px-6 md:py-14 lg:px-8">
			<div class="grid gap-8 md:grid-cols-[280px_minmax(0,1fr)] lg:gap-14">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
						Understanding coverage
					</p>

					<h2 class="mt-3 text-2xl font-bold tracking-tight text-slate-950">What warranty means</h2>

					<p class="mt-3 text-sm leading-7 text-slate-600">
						Warranty provides applicable protection against qualifying product faults, subject to
						the terms attached to the particular product.
					</p>
				</div>

				<div class="grid gap-4 sm:grid-cols-2">
					<div class="rounded-2xl border border-slate-200 bg-white p-5">
						<div class="flex size-10 items-center justify-center rounded-xl bg-blue-50">
							<BadgeCheck class="size-5 text-blue-600" />
						</div>

						<h3 class="mt-4 text-base font-bold text-slate-950">Manufacturer warranty</h3>

						<p class="mt-2 text-sm leading-6 text-slate-500">
							Some products are covered directly by their manufacturer and may be subject to the
							manufacturer's warranty process and conditions.
						</p>
					</div>

					<div class="rounded-2xl border border-slate-200 bg-white p-5">
						<div class="flex size-10 items-center justify-center rounded-xl bg-blue-50">
							<PackageCheck class="size-5 text-blue-600" />
						</div>

						<h3 class="mt-4 text-base font-bold text-slate-950">Product-specific coverage</h3>

						<p class="mt-2 text-sm leading-6 text-slate-500">
							Coverage periods and conditions may differ between devices, accessories, components,
							software and other products.
						</p>
					</div>

					<div class="rounded-2xl border border-slate-200 bg-white p-5">
						<div class="flex size-10 items-center justify-center rounded-xl bg-emerald-50">
							<FileCheck2 class="size-5 text-emerald-600" />
						</div>

						<h3 class="mt-4 text-base font-bold text-slate-950">Keep your purchase details</h3>

						<p class="mt-2 text-sm leading-6 text-slate-500">
							Your order number, receipt, serial number or other purchase information may be
							required when a warranty request is reviewed.
						</p>
					</div>

					<div class="rounded-2xl border border-slate-200 bg-white p-5">
						<div class="flex size-10 items-center justify-center rounded-xl bg-slate-100">
							<Wrench class="size-5 text-slate-600" />
						</div>

						<h3 class="mt-4 text-base font-bold text-slate-950">Resolution depends on the issue</h3>

						<p class="mt-2 text-sm leading-6 text-slate-500">
							Depending on the applicable warranty, the resolution may involve troubleshooting,
							repair, replacement or another approved remedy.
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Warranty process -->
	<section class="border-t border-slate-200 bg-white">
		<div class="mx-auto max-w-[1440px] px-4 py-10 sm:px-6 md:py-14 lg:px-8">
			<div class="max-w-2xl">
				<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">Warranty support</p>

				<h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
					What to do when something goes wrong
				</h2>

				<p class="mt-3 text-sm leading-7 text-slate-600">
					Have your product and order information ready before contacting us. This helps us identify
					the appropriate warranty path more quickly.
				</p>
			</div>

			<div class="mt-8 border-t border-slate-200">
				<div
					class="grid gap-3 border-b border-slate-200 py-6 md:grid-cols-[80px_260px_minmax(0,1fr)] md:gap-8"
				>
					<p class="text-sm font-bold text-blue-600">01</p>

					<h3 class="text-base font-bold text-slate-950">Tell us about the issue</h3>

					<p class="max-w-2xl text-sm leading-6 text-slate-500">
						Contact TweakMart with your order details, product information and a clear description
						of the problem you're experiencing.
					</p>
				</div>

				<div
					class="grid gap-3 border-b border-slate-200 py-6 md:grid-cols-[80px_260px_minmax(0,1fr)] md:gap-8"
				>
					<p class="text-sm font-bold text-blue-600">02</p>

					<h3 class="text-base font-bold text-slate-950">We identify the coverage</h3>

					<p class="max-w-2xl text-sm leading-6 text-slate-500">
						We'll review the purchase and applicable warranty information to determine how the issue
						should be handled.
					</p>
				</div>

				<div
					class="grid gap-3 border-b border-slate-200 py-6 md:grid-cols-[80px_260px_minmax(0,1fr)] md:gap-8"
				>
					<p class="text-sm font-bold text-blue-600">03</p>

					<h3 class="text-base font-bold text-slate-950">Follow the assessment process</h3>

					<p class="max-w-2xl text-sm leading-6 text-slate-500">
						We may ask for additional information, troubleshooting steps, photographs or for the
						product to be made available for assessment.
					</p>
				</div>

				<div
					class="grid gap-3 border-b border-slate-200 py-6 md:grid-cols-[80px_260px_minmax(0,1fr)] md:gap-8"
				>
					<p class="text-sm font-bold text-blue-600">04</p>

					<h3 class="text-base font-bold text-slate-950">Appropriate resolution</h3>

					<p class="max-w-2xl text-sm leading-6 text-slate-500">
						Once the issue has been assessed, we'll communicate the available resolution based on
						the applicable warranty terms.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Coverage guidance -->
	<section>
		<div class="mx-auto max-w-[1440px] py-10 sm:px-6 md:py-14 lg:px-8">
			<div class="grid overflow-hidden rounded-3xl border border-slate-200 bg-white md:grid-cols-2">
				<!-- Commonly covered -->
				<div class="p-6 sm:p-8 md:p-10">
					<div class="flex size-11 items-center justify-center rounded-xl bg-emerald-50">
						<CheckCircle2 class="size-5 text-emerald-600" />
					</div>

					<p class="mt-6 text-xs font-bold uppercase tracking-[0.18em] text-emerald-700">
						May be covered
					</p>

					<h2 class="mt-2 text-xl font-bold text-slate-950">Qualifying product faults</h2>

					<p class="mt-3 text-sm leading-6 text-slate-500">
						Depending on the applicable warranty, coverage may apply to manufacturing defects or
						qualifying hardware faults that occur during normal intended use.
					</p>

					<ul class="mt-6 space-y-4">
						<li class="flex items-start gap-3">
							<CheckCircle2 class="mt-0.5 size-4 shrink-0 text-emerald-600" />

							<span class="text-sm leading-6 text-slate-600">
								Qualifying manufacturing defects
							</span>
						</li>

						<li class="flex items-start gap-3">
							<CheckCircle2 class="mt-0.5 size-4 shrink-0 text-emerald-600" />

							<span class="text-sm leading-6 text-slate-600">
								Covered hardware failures during normal use
							</span>
						</li>

						<li class="flex items-start gap-3">
							<CheckCircle2 class="mt-0.5 size-4 shrink-0 text-emerald-600" />

							<span class="text-sm leading-6 text-slate-600">
								Other faults specifically included by the applicable warranty
							</span>
						</li>
					</ul>
				</div>

				<!-- Common exclusions -->
				<div
					class="border-t border-slate-200 bg-slate-50 p-6 sm:p-8 md:border-l md:border-t-0 md:p-10"
				>
					<div class="flex size-11 items-center justify-center rounded-xl bg-rose-50">
						<XCircle class="size-5 text-rose-600" />
					</div>

					<p class="mt-6 text-xs font-bold uppercase tracking-[0.18em] text-rose-700">
						May not be covered
					</p>

					<h2 class="mt-2 text-xl font-bold text-slate-950">Damage outside warranty terms</h2>

					<p class="mt-3 text-sm leading-6 text-slate-500">
						Warranty generally does not replace appropriate care of a product. The exact exclusions
						depend on the warranty attached to the item.
					</p>

					<ul class="mt-6 space-y-4">
						<li class="flex items-start gap-3">
							<XCircle class="mt-0.5 size-4 shrink-0 text-rose-500" />

							<span class="text-sm leading-6 text-slate-600">
								Accidental or physical damage where not specifically covered
							</span>
						</li>

						<li class="flex items-start gap-3">
							<XCircle class="mt-0.5 size-4 shrink-0 text-rose-500" />

							<span class="text-sm leading-6 text-slate-600">
								Misuse or operation outside manufacturer guidance
							</span>
						</li>

						<li class="flex items-start gap-3">
							<XCircle class="mt-0.5 size-4 shrink-0 text-rose-500" />

							<span class="text-sm leading-6 text-slate-600">
								Unauthorized modification or repair where it invalidates applicable coverage
							</span>
						</li>
					</ul>
				</div>
			</div>

			<div class="mt-4 flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 p-4">
				<CircleHelp class="mt-0.5 size-5 shrink-0 text-amber-700" />

				<p class="text-xs leading-5 text-amber-900">
					The examples above are general guidance only. The warranty terms supplied with the
					specific product determine its actual coverage and exclusions.
				</p>
			</div>
		</div>
	</section>

	<!-- Product information reminder -->
	<section class="border-t border-slate-200 bg-white">
		<div class="mx-auto max-w-[1440px] py-10 sm:px-6 md:py-14 lg:px-8">
			<div
				class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] md:items-center lg:gap-16"
			>
				<div>
					<div class="flex size-11 items-center justify-center rounded-xl bg-blue-50">
						<Box class="size-5 text-blue-600" />
					</div>

					<h2 class="mt-5 text-2xl font-bold tracking-tight text-slate-950">
						Keep the product information available
					</h2>

					<p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600">
						Serial numbers, packaging, supplied accessories and warranty documentation can help
						identify the product and applicable coverage when support is required.
					</p>
				</div>

				<div class="rounded-2xl bg-slate-50 p-6">
					<p class="text-sm font-bold text-slate-950">Useful information to have</p>

					<ul class="mt-4 space-y-3">
						<li class="flex items-center gap-3">
							<span class="size-1.5 shrink-0 rounded-full bg-blue-600"></span>
							<span class="text-sm text-slate-600"> TweakMart order number</span>
						</li>

						<li class="flex items-center gap-3">
							<span class="size-1.5 shrink-0 rounded-full bg-blue-600"></span>
							<span class="text-sm text-slate-600"> Product name and model</span>
						</li>

						<li class="flex items-center gap-3">
							<span class="size-1.5 shrink-0 rounded-full bg-blue-600"></span>
							<span class="text-sm text-slate-600"> Serial number, where applicable</span>
						</li>

						<li class="flex items-center gap-3">
							<span class="size-1.5 shrink-0 rounded-full bg-blue-600"></span>
							<span class="text-sm text-slate-600"> Description of the fault</span>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- Support CTA -->
	<section>
		<div class="mx-auto max-w-[1440px] py-10 sm:px-6 md:py-14 lg:px-8">
			<div class="overflow-hidden rounded-3xl bg-[#000033]">
				<div class="grid md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
					<div class="p-6 sm:p-8 md:p-10">
						<div class="flex size-11 items-center justify-center rounded-xl bg-white/10">
							<Headphones class="size-5 text-blue-200" />
						</div>

						<h2 class="mt-5 text-2xl font-bold tracking-tight text-white">
							Need warranty assistance?
						</h2>

						<p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300">
							Contact TweakMart with your order number and product details and we'll help you
							identify the appropriate warranty process.
						</p>
					</div>

					<div class="border-t border-white/10 p-6 sm:p-8 md:border-l md:border-t-0 md:p-10">
						<a
							href="/support"
							class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-white px-6 text-sm font-bold text-slate-950 transition hover:bg-blue-50 md:w-auto"
						>
							Contact Support
							<ArrowRight class="size-4" />
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>
