---
import { ArrowRight, PackageSearch } from 'lucide-astro';
import CategoryCard from '~/components/storefront/CategoryCard.astro';
import Layout from '../../layouts/PrimaryLayout.astro';
import { getStorefrontCategories } from '../../lib/tweakmart/storefront-categories';

const categories = await getStorefrontCategories();
---

<Layout
	title="Shop by Category | TweakMart"
	description="Browse TweakMart products by category, from computers and mobile devices to networking, software, accessories and more."
>
	<main class="min-h-screen bg-white">
		<!-- Collections hero -->
		<section class="border-b border-slate-200">
			<div class="mx-auto max-w-[1440px] py-10 sm:px-6 lg:px-8 lg:py-14">
				<nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-slate-500">
					<a href="/" class="transition hover:text-blue-600"> Home</a>

					<span aria-hidden="true">/</span>

					<span class="font-semibold text-slate-900"> Categories</span>
				</nav>

				<div class="mt-7 max-w-3xl">
					<h1 class="mt-3 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl lg:text-5xl">
						Shop by category
					</h1>

					<p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600 sm:text-base">
						Find the technology you need faster. Browse our product categories and discover
						hardware, software, accessories and business technology available through TweakMart.
					</p>
				</div>
			</div>
		</section>

		<!-- Category collection -->
		<section class="mx-auto max-w-[1440px] py-10 sm:px-6 lg:px-8 lg:py-14">
			{
				categories.length === 0 ? (
					<div class="flex min-h-[420px] flex-col items-center justify-center rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 text-center">
						<div class="flex size-16 items-center justify-center rounded-2xl bg-white shadow-sm">
							<PackageSearch class="size-7 text-slate-400" />
						</div>

						<h2 class="mt-5 text-xl font-bold text-slate-950">No categories available</h2>

						<p class="mt-2 max-w-md text-sm leading-6 text-slate-500">
							There are currently no active TweakMart categories available for shopping.
						</p>

						<a
							href="/products"
							class="mt-6 inline-flex min-h-11 items-center justify-center rounded-xl bg-blue-600 px-5 text-sm font-bold text-white transition hover:bg-blue-700"
						>
							Browse all products
						</a>
					</div>
				) : (
					<>
						<div class="mb-6 flex items-end justify-between gap-4">
							<div>
								<h2 class="text-xl font-bold text-slate-950">All categories</h2>

								<p class="mt-1 text-sm text-slate-500">
									{categories.length === 1 ? '1 category' : `${categories.length} categories`}
								</p>
							</div>

							<a
								href="/products"
								class="hidden items-center gap-2 text-sm font-bold text-blue-600 transition hover:text-blue-700 sm:flex"
							>
								View all products
								<ArrowRight class="size-4" />
							</a>
						</div>

						<div class="grid grid-cols-2 gap-3 sm:gap-5 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
							{categories.map((category) => (
								<CategoryCard
									name={category.name}
									slug={category.slug}
									description={category.description}
									imageUrl={category.image_url}
									featured={category.featured}
								/>
							))}
						</div>

						<div class="mt-8 sm:hidden">
							<a
								href="/products"
								class="flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 text-sm font-bold text-slate-800 transition hover:border-blue-200 hover:text-blue-600"
							>
								View all products
								<ArrowRight class="size-4" />
							</a>
						</div>
					</>
				)
			}
		</section>

		<!-- Business purchasing callout -->
		<section class="mx-auto max-w-[1440px] pb-12 sm:px-6 lg:px-8 lg:pb-16">
			<div
				class="overflow-hidden rounded-3xl bg-blue-900 px-6 py-8 sm:px-8 lg:flex lg:items-center lg:justify-between lg:gap-10 lg:px-10 lg:py-10"
			>
				<div class="max-w-2xl">
					<p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-200">
						Buying for your organization?
					</p>

					<h2 class="mt-2 text-2xl font-bold text-white lg:text-3xl">
						Need help sourcing the right technology?
					</h2>

					<p class="mt-3 text-sm leading-6 text-blue-100">
						CloudTweak can help your organization source, configure and procure technology based on
						your business requirements.
					</p>
				</div>

				<div class="mt-6 grid grid-cols-2 gap-3 lg:mt-0 lg:shrink-0">
					<a
						href="/request-quote"
						class="inline-flex min-h-11 items-center justify-center rounded-xl bg-pink-500 px-5 text-sm font-bold text-white transition hover:bg-pink-600"
					>
						Request a Quote
					</a>

					<a
						href="/technical-support"
						class="inline-flex min-h-11 items-center justify-center rounded-xl border border-white/20 px-5 text-sm font-bold text-white transition hover:bg-white/10"
					>
						Contact Us
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
