---
import { getStorefrontProducts, type StorefrontProduct } from '~/lib/tweakmart/storefront-products';

import ProductCard from '../../components/storefront/ProductCard.astro';

import ProductCarousel, { MEASURED_ITEM_ID, GAP } from './ProductCarousel.tsx';

type Props = {
	heading: string;
	limit?: number;
	featured?: boolean;
	categoryId?: string;
	categoryName?: string;
	brandId?: string;
	class?: string;
	productType?: string;
	imageLoading?: "eager" | "lazy";
	filterProducts?: (products: StorefrontProduct[]) => StorefrontProduct[];
};

const {
	heading,
	limit = 12,
	featured,
	categoryId,
	categoryName,
	brandId,
	productType,
	filterProducts = (products: StorefrontProduct[]) => products,
} = Astro.props;

/* Loads active and published TweakMart products for this carousel. */
const storefrontProducts: StorefrontProduct[] = await getStorefrontProducts({
	limit,
	featured,
	categoryId,
	categoryName,
	brandId,
	productType,
});

/* Applies optional carousel-specific filtering and removes unavailable products. */
const products: StorefrontProduct[] = filterProducts(storefrontProducts).filter(
	(product: StorefrontProduct) => product.inventory.in_stock,
);
---

{
	products.length > 0 && (
		<ProductCarousel {heading} client:idle>
			<ul
				class="flex w-max pb-4"
				style={{
					gap: GAP + 'px',
				}}
			>
				{products.map((product: StorefrontProduct, idx: number) => (
					<li id={idx === 0 ? MEASURED_ITEM_ID : undefined} class="shrink-0 snap-start">
						<ProductCard {...product} class="w-72" imageLoading={idx === 0 ? 'eager' : 'lazy'} />
					</li>
				))}
			</ul>
		</ProductCarousel>
	)
}
